{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "App": {
        "Url": "https://localhost:55000"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ufo.db;Foreign Keys=True"
  },
  // SECURITY: JWT:Key is a secret and is deliberately absent here. Supply it out
  // of source control - `dotnet user-secrets set "JWT:Key" "<value>" --project Ufo.Server`
  // for development, or the JWT__Key environment variable for a deployment.
  // Generate one with `openssl rand -hex 32`. The host refuses to start without it.
  // TokenLifetimeMinutes is how long an access token stays valid; omit it for the
  // 30-minute default. It is short because an access token cannot be revoked, and
  // it does not decide how long a session lasts: the client renews it with the
  // refresh token in its cookie, which is revocable and lives in the database.
  // RefreshTokenLifetimeDays is the idle window - it slides on every renewal -
  // and RefreshTokenAbsoluteLifetimeDays caps one sign-in however actively it is
  // used. Override any of them with JWT__<name> environment variables.
  "JWT": {
    "Issuer": "UFO",
    "Audience": "UFO",
    "TokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 14,
    "RefreshTokenAbsoluteLifetimeDays": 30
  }
}
