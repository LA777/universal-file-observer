{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "App": {
        "Url": "https://localhost:55000"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ufo.db;Foreign Keys=True"
  },
  // SECURITY: JWT:Key is a secret and is deliberately absent here. Supply it out
  // of source control - `dotnet user-secrets set "JWT:Key" "<value>" --project Ufo.Server`
  // for development, or the JWT__Key environment variable for a deployment.
  // Generate one with `openssl rand -hex 32`. The host refuses to start without it.
  "JWT": {
    "Issuer": "UFO",
    "Audience": "UFO"
  }
}
