<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SpaRoot>..\ufo.client\</SpaRoot>
		<DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
		<SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:4200</SpaProxyServerUrl>
		<!-- Holds JWT:Key for development. Never commit a signing key; see appsettings.json. -->
		<UserSecretsId>0f5701f6-d9ae-4970-a752-29ff89266396</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<!-- Development-only overrides; they have no business inside a published
		     artifact. The JWT signing key lives in user-secrets, not in either file. -->
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
		<!-- Development only: the container image and the desktop executable must not ship it. -->
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.9" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ufo.Abstractions\Ufo.Abstractions.csproj" />
		<!-- Excluded with -p:BuildSpa=false: the Docker build stage does not copy the
		     Angular sources into the .NET SDK image, and building an esproj there
		     would need Node anyway. -->
		<ProjectReference Include="..\ufo.client\ufo.client.esproj" Condition="'$(BuildSpa)' != 'false'">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Include="..\Ufo.Database\Ufo.Database.csproj" />
	</ItemGroup>

	<!-- Skipped with -p:BuildSpa=false, which is what the Docker build does: the
	     Angular bundle is produced by a dedicated node stage so the .NET SDK image
	     does not need Node installed. -->
	<Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish" Condition="'$(BuildSpa)' != 'false'">
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production" />

		<ItemGroup>
			<DistFiles Include="$(SpaRoot)dist\ufo.client\browser\**" />

			<ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
